# A first-run wizard writes the selected MySQL or SQLite configuration to
# PIXXEL247_DATA_DIR/site.config.json. DATABASE_URL and the ADMIN_* values are
# only needed for the legacy/preconfigured development path.
PIXXEL247_DATA_DIR="data"
JWT_SECRET="change-me-to-a-long-random-string"
# Optional dedicated AES key for encrypted monitoring headers/bodies.
# If omitted, JWT_SECRET is used.
MONITORING_ENCRYPTION_KEY="change-me-to-an-independent-long-random-string"
# DATABASE_URL="mysql://USER:PASS@HOST:3306/pixxel247"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD_HASH="\$2b\$10\$..."
